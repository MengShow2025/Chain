# TitanChain Smart Contract Environment Configuration

# Private Keys (DO NOT commit real private keys to version control)
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here
USER_PRIVATE_KEY=your_user_private_key_here

# Network Configuration
TITANCHAIN_RPC_URL=http://localhost:8545
TITANCHAIN_TESTNET_RPC_URL=https://testnet-rpc.titanchain.io

# Etherscan API Key (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Gas Configuration
GAS_PRICE=20000000000
GAS_LIMIT=8000000

# Contract Configuration
INITIAL_SUPPLY=1000000000
REWARD_PER_SECOND=1000000000000000000
LOCK_DURATION=604800